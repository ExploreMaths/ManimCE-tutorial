    },
    {
      "type": "demo",
      "example": "ch03/markup_text_demo",
      "scene": "MarkupTextDemo",
      "caption": "<p><code>&lt;span&gt;</code> 的 <code>foreground</code>/<code>size</code> 控制标题颜色与字号；<code>&lt;sup&gt;</code>/<code>&lt;sub&gt;</code> 直接排出上下标；<code>&lt;b&gt;</code>/<code>&lt;i&gt;</code> 是粗斜体的简写。</p>",
      "code": "\"\"\"MarkupTextDemo: Pango 标记语言的常用标签。\"\"\"\n\nfrom manim import *\n\n\nclass MarkupTextDemo(Scene):\n    def construct(self):\n        title = MarkupText('<span foreground=\"#FFFF00\" size=\"x-large\">Pango 标记语言</span>')\n        body = MarkupText(\n            '上下标：x<sup>2</sup> + y<sub>i</sub>，<b>粗体</b> 与 <i>斜体</i>',\n            font_size=32,\n        )\n        body.next_to(title, DOWN, buff=0.6)\n\n        self.play(FadeIn(title))\n        self.play(FadeIn(body, shift=UP))\n        self.wait(0.5)\n",
      "video": null
    },
    {
      "type": "heading",
      "level": 3,
      "id": "与-text-的对比",
      "text": "与 Text 的对比"
    },
    {
